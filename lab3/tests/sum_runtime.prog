% Test 4 : sum of N numbers, N is given at run time
%   address 0x0        : N
%   address 0x4 .. 4N  : the N numbers
%   result is stored at address  N*4 + 4

x1 = 0          % index
x2 = 0          % sum
x3 = 0          % address
x4 = [x3]       % N
.loopback
x15 = x1 - x4   % index - N , only to set the Z flag
BEQ .exit
x3 = x3 + 4     % go to next number
x6 = [x3]       % load the number
x2 = x2 + x6    % add it in the sum
x1 = x1 + 1     % next index
BAL .loopback
.exit
x3 = x3 + 4     % now x3 = N*4 + 4
[x3] = x2       % store the sum
