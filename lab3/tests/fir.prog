% FIR filter with vector instructions
%   address 0x0            : N  (multiple of 8, not more than 64)
%   address 0x4  .. 0x23   : the 8 weights
%   address 0x24 ..        : the input array of N numbers
%   address 0x100 ..       : the output
%
% for(k = 0; k < N-8; k++) {
%     sum = 0
%     for(i = 0; i < 8; i++) sum = sum + input[k+i] * weight[i]
%     output[k] = sum
% }
%
% The 8 multiplications of one output value are done with a single vector
% instruction.  The 8 products are then written in a scratch area of the
% data memory and added there, because the language has no instruction
% which adds the elements of one vector together.
%
% k counts down from N-9 to 0 instead of up.  With the biggest N the input
% (0x24 .. 0x24+4N) and the output (0x100 ..) share a few addresses, and
% going backwards writes an output value only after the input values which
% it covers have already been read.

x1 = [0]        % N
x2 = x1 - 8     % number of output values
BEQ .done       % N = 8 gives no output at all

v1 = [4]        % the 8 weights, loaded only once

x10 = x2 * 4
x10 = x10 - 4   % 4 * (N-9) , distance up to the last window

x3 = 36         % address of input[0] (0x24)
x3 = x3 + x10   % address of input[N-9] , the last window
x4 = 128
x4 = x4 + 128   % address of output[0] (0x100), constants are max 255
x4 = x4 + x10   % address of output[N-9]
x5 = 128
x5 = x5 * 8     % scratch area at 1024, far away from input and output

.outer
v2 = [x3]       % input[k .. k+7]
v3 = v2 * v1    % the 8 products in one instruction
[x5] = v3       % keep the products in the scratch area

x6 = 0          % sum
x7 = x5         % address inside the scratch area
x8 = 8          % 8 products have to be added
.inner
x9 = [x7]
x6 = x6 + x9
x7 = x7 + 4
x8 = x8 - 1
BNE .inner

[x4] = x6       % output[k] = sum
x3 = x3 - 4     % the window moves back by one number
x4 = x4 - 4
x2 = x2 - 1
BNE .outer
.done
