% Test 3 : determinant of a 3x3 matrix
%   matrix is stored row wise from address 0 :
%       a b c   ->  0  4  8
%       d e f   -> 12 16 20
%       g h i   -> 24 28 32
%   determinant = a(ei - fh) - b(di - fg) + c(dh - eg)
%   answer is stored at address 36

x1 = [0]        % a
x2 = [4]        % b
x3 = [8]        % c
x4 = [12]       % d
x5 = [16]       % e
x6 = [20]       % f
x7 = [24]       % g
x8 = [28]       % h
x9 = [32]       % i

x10 = x5 * x9
x11 = x6 * x8
x12 = x10 - x11 % ei - fh
x20 = x1 * x12  % a * (ei - fh)

x13 = x4 * x9
x14 = x6 * x7
x15 = x13 - x14 % di - fg
x21 = x2 * x15  % b * (di - fg)

x16 = x4 * x8
x17 = x5 * x7
x18 = x16 - x17 % dh - eg
x22 = x3 * x18  % c * (dh - eg)

x30 = x20 - x21
x30 = x30 + x22

[36] = x30
